{
	"ignoreExports": [
		{
			"file": "src/components/ui/**",
			"exports": ["*"],
		},
		// reachable only through the fallow-ignored ui/spinner.tsx
		{
			"file": "src/components/icons.tsx",
			"exports": ["CircleNotchBold"],
		},
	],
	// shadcn component library + its support files: reachable only from each
	// other until an app route imports them
	"ignorePatterns": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
	"ignoreDependencies": [
		// only imported by the fallow-ignored shadcn ui components
		"@remixicon/react",
		"class-variance-authority",
	],
}

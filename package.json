{
	"name": "imdbgraph",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"start": "varlock run -- node .output/server/index.mjs",
		"check": "vp check",
		"test": "vp test run",
		"test:unit": "vp test run --project unit",
		"test:server": "vp test run --project server",
		"test:browser": "vp test run --project browser",
		"test:update": "vp test run --project browser --update",
		"test:watch": "vp test --watch",
		"test:ui": "vp test dev --ui --open=false --project browser --api.port ${APP_PORT:-5123} --api.strictPort",
		"e2e": "varlock run -- playwright test",
		"e2e:update": "varlock run -- playwright test --update-snapshots",
		"report": "playwright show-report .playwright/report",
		"compose:up": "docker compose --env-file .env.development.local up -d --wait --remove-orphans postgres",
		"compose:down": "docker compose --env-file .env.development.local down",
		"compose:reset": "docker compose --env-file .env.development.local down --volumes --remove-orphans && vp run compose:up",
		"db:push": "varlock run -- drizzle-kit push",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate": "varlock run -- tsx scripts/migrate.ts",
		"db:populate": "varlock run -- tsx scripts/populate-db.ts",
		"prepare": "vp config --hooks-only",
		"update-pnpm": "corepack use pnpm@11",
		"dead-code": "fallow dead-code"
	},
	"dependencies": {
		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-start": "1.168.32",
		"@tanstack/router-plugin": "1.168.18",
		"@vitejs/plugin-react": "^6.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.1",
		"lucide-react": "^1.16.0",
		"nitro": "3.0.260610-beta",
		"pg": "^8.22.0",
		"pg-copy-streams": "^7.0.0",
		"posthog-js": "^1.391.2",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"recharts": "3.8.0",
		"tailwind-merge": "^3.6.0",
		"varlock": "^1.14.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/devtools-vite": "0.8.0",
		"@testcontainers/postgresql": "^12.0.3",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@types/pg-copy-streams": "^1.2.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@varlock/vite-integration": "^1.4.0",
		"@vitest/browser-playwright": "4.1.9",
		"@vitest/ui": "4.1.9",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.9",
		"drizzle-seed": "^0.3.1",
		"fallow": "^3.6.0",
		"msw": "^2.14.6",
		"oxlint-plugin-eslint": "^1.73.0",
		"shadcn": "^4.11.0",
		"tailwindcss": "^4.3.1",
		"testcontainers": "^12.0.3",
		"tsx": "^4.22.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-react": "^2.2.0"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
